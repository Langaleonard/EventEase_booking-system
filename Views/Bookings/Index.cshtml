@model IEnumerable<EventEase_booking_system.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1>Bookings</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2">

        <div class="col-md-3">
            <input type="text"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Search by Booking ID, Event, Venue, or Location" />
        </div>

        <div class="col-md-2">
            <select name="eventTypeId" class="form-control" asp-items="ViewBag.EventTypeId">
                <option value="">All Event Types</option>
            </select>
        </div>

        <div class="col-md-2">
            <input type="date"
                   name="startDate"
                   value="@ViewData["CurrentStartDate"]"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <input type="date"
                   name="endDate"
                   value="@ViewData["CurrentEndDate"]"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <select name="isAvailable" class="form-control">
                <option value="">All Venues</option>

                @if (ViewData["CurrentAvailability"] as bool? == true)
                {
                    <option value="true" selected>Available Venues</option>
                }
                else
                {
                    <option value="true">Available Venues</option>
                }

                @if (ViewData["CurrentAvailability"] as bool? == false)
                {
                    <option value="false" selected>Unavailable Venues</option>
                }
                else
                {
                    <option value="false">Unavailable Venues</option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">
                Filter
            </button>
        </div>

    </div>

    <div class="mt-2">
        <a asp-action="Index" class="btn btn-secondary">
            Reset
        </a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Event Name</th>
            <th>Event Type</th>
            <th>Venue Name</th>
            <th>Location</th>
            <th>Availability</th>
            <th>Booking Date</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.BookingId</td>

            <td>
                @item.Event?.EventName
            </td>

            <td>
                @item.Event?.EventType?.Name
            </td>

            <td>
                @item.Venue?.VenueName
            </td>

            <td>
                @item.Venue?.Location
            </td>

            <td>
                @if (item.Venue != null && item.Venue.IsAvailable)
                {
                    <span class="badge bg-success">Available</span>
                }
                else
                {
                    <span class="badge bg-danger">Unavailable</span>
                }
            </td>

            <td>
                @item.BookingDate.ToString("yyyy-MM-dd")
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>